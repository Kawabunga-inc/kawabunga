# ── Local dev ports ──────────────────────────────────────────────
# Give this checkout its own contiguous block so it never fights another
# project's dev servers. Unset = the historical 3000/3001/8080/8081.
#   KAWABUNGA_PORT_BASE=4200  → web 4200 · admin 4201 · voice-host 4202 · agent health 4203
# `npm run dev:ports` prints the resolved map. Per-service pins override it:
# WEB_PORT / ADMIN_PORT / VOICE_HOST_PORT / VOICE_AGENT_DEV_HEALTH_PORT.
# KAWABUNGA_PORT_BASE=4200

DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/odyssey?sslmode=require
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_BASE_URL=http://localhost:3001

# Auth.js / NextAuth. Generate AUTH_SECRET with:
#   npx auth secret
# Google OAuth callback URLs:
#   Web app local:   http://localhost:3000/api/auth/callback/google
#   Admin app local: http://localhost:3001/api/auth/callback/google
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

OPENAI_API_KEY=sk-example

# Admin agent GitHub/Codex delegation. Prefer a GitHub App installation token
# or fine-grained PAT scoped to the repo permissions needed for issues,
# comments, PR status reads, and protected-branch merges.
ADMIN_AGENT_GITHUB_TOKEN=
ADMIN_AGENT_GITHUB_REPOSITORIES=Kawabunga-inc/kawabunga
ADMIN_AGENT_GITHUB_DEFAULT_REPOSITORY=Kawabunga-inc/kawabunga

# Wiki ingestion worker. Writer concurrency controls how many page-writing LLM
# calls run at once per claimed ingestion job.
WIKI_INGEST_WORKER_ID=local-wiki-ingest-1
WIKI_INGEST_POLL_MS=2000
WIKI_INGEST_WRITER_CONCURRENCY=3

# Scene turn orchestrator. Leave ORCHESTRATOR_PROVIDER empty to use the first
# configured key in this order: Cerebras, then Groq.
ORCHESTRATOR_PROVIDER=
CEREBRAS_API_KEY=
CEREBRAS_ORCHESTRATOR_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_ORCHESTRATOR_MODEL=openai/gpt-oss-120b
# Reasoning headroom for the director's strict-JSON decision (gpt-oss thinks
# before answering; too low truncates to an empty completion → degraded turn).
ORCHESTRATOR_MAX_COMPLETION_TOKENS=2500

# xAI (Grok) — OpenAI-compatible chat provider (grok-4.3, grok-4.5).
# Console: console.x.ai. Brain-lane only; not an orchestrator provider.
XAI_API_KEY=

# Google Gemini — via the Gemini API's OpenAI-compat endpoint (Flash family).
# Key: aistudio.google.com. Brain-lane only; not an orchestrator provider.
GEMINI_API_KEY=

# Additional OpenAI-compatible brain-lane providers (adapters wired; registry
# entries land after the first key + live /models check for each):
# FIREWORKS_API_KEY=            # open-weights catalog (DeepSeek, Kimi, Qwen, GLM)
# DEEPSEEK_API_KEY=             # DeepSeek first-party — the cost floor
# BASETEN_API_KEY=              # lowest-TTFT gpt-oss-120b host (per AA)
# Director A/B knob: a model-registry id (Cerebras/Groq only — the director
# needs their strict-json_schema endpoints). Picks provider AND model in one
# move, outranking everything above; the matching key must be set. Invalid
# values warn once and are ignored.
# ORCHESTRATOR_MODEL=zai-glm-4.7

TTS_PROVIDER=openai
TTS_ENABLE_FALLBACK=false
TTS_FALLBACK_PROVIDER=elevenlabs
VOICE_ACK_LANE=1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
NEXT_PUBLIC_LANDING_HERO_VIDEO_MP4=https://cdn.example.com/landing_page_video_optimized.mp4
NEXT_PUBLIC_LANDING_HERO_VIDEO_HD_MP4=https://scmrwqpkj7u5w0gc.public.blob.vercel-storage.com/videos/odyssey.mp4
NEXT_PUBLIC_LANDING_HERO_VIDEO_WEBM=https://cdn.example.com/landing_page_video_optimized.webm

# Admin core background video. Upload the files from
# `.generated/odyssey-bg-video/` to Supabase Storage and paste the public URLs.
NEXT_PUBLIC_ODYSSEY_CORE_BG_POSTER_URL=
NEXT_PUBLIC_ODYSSEY_CORE_BG_LQIP_URL=
NEXT_PUBLIC_ODYSSEY_CORE_BG_PREVIEW_MP4_URL=
NEXT_PUBLIC_ODYSSEY_CORE_BG_PREVIEW_WEBM_URL=
NEXT_PUBLIC_ODYSSEY_CORE_BG_HD_MP4_URL=
NEXT_PUBLIC_ODYSSEY_CORE_BG_HD_WEBM_URL=

# Supabase Storage — character thumbnail uploads land in the
# `character-thumbnails` bucket. Create one in the Supabase dashboard
# (Storage → New bucket → public) before uploads will work.
#
# SUPABASE_SECRET_KEY is the new name for what used to be called
# `service_role` (Project Settings → API Keys → Secret keys). The route
# also accepts the legacy `SUPABASE_SERVICE_ROLE_KEY` name if your
# project predates the rename.
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=sb_secret_example_key
