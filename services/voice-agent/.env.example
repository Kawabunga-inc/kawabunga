# services/voice-agent — environment.
# Run: npx tsx --env-file=services/voice-agent/.env services/voice-agent/src/agent.ts dev
#
# Vars are grouped REQUIRED / RECOMMENDED / OPTIONAL. The brain block (DATABASE_URL +
# the LLM/TTS/Supabase keys) is byte-identical to what services/voice-host runs in
# prod — the fastest path is to copy those values from your voice-host deploy.

# ============================== REQUIRED ==============================

# --- LiveKit worker (read by @livekit/agents itself; the worker won't register
#     without them). Create a project at cloud.livekit.io → Settings → Keys. ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Which character this worker voices (id or slug runVoiceStream resolves). ---
VOICE_AGENT_CHARACTER_ID=abraham

# --- The brain (runVoiceStream) — knowledge graph + the default Abraham voice path. ---
DATABASE_URL=                 # Postgres/Neon: the knowledge graph + voice sessions
CEREBRAS_API_KEY=             # Abraham's LLM (gpt-oss-120b)
ELEVENLABS_API_KEY=           # Abraham's voice (james-husky, provider=elevenlabs)
SUPABASE_URL=                 # voices table + audio storage
SUPABASE_SECRET_KEY=          # ...or SUPABASE_SERVICE_ROLE_KEY (either is accepted)

# ============================= RECOMMENDED ===========================
# Fallbacks — set if you have them (harmless if pasted, avoid surprise failures).

OPENAI_API_KEY=               # embed fallback (won't fire with warm bge) + some paths
GROQ_API_KEY=                 # alternate LLM provider
ANTHROPIC_API_KEY=            # provider / orchestrator fallback
XAI_API_KEY=                  # xAI Grok (brain-lane models grok-4.3 / grok-4.5)
GEMINI_API_KEY=               # Google Gemini Flash family (brain-lane)
# FIREWORKS_API_KEY=            # open-weights catalog (adapter wired, entries pending)
# DEEPSEEK_API_KEY=             # DeepSeek first-party (adapter wired, entries pending)
# BASETEN_API_KEY=              # low-TTFT gpt-oss host (adapter wired, entries pending)

# STT via LiveKit Inference — billed through LiveKit, NO separate STT key.
# deepgram/nova-3 | assemblyai/universal-streaming | deepgram/nova-2 | …
VOICE_AGENT_STT=deepgram/nova-3

# ============================== OPTIONAL =============================
# Only needed if you change providers or tune. All have defaults.

# Brain-model override — the live A/B knob. Every character turn this worker
# voices runs on this model instead of the character's saved brainModel (same
# precedence as the wavefield UI's live picker; the matching provider key must
# be set). Must be a model-registry id; unknown ids are ignored with a warning.
# VOICE_AGENT_BRAIN_MODEL=claude-haiku-4-5

# Director model override — same pattern for the scene orchestrator (this
# worker runs it in-process). Registry id, Cerebras/Groq only (the director
# needs their strict-json_schema endpoints); picks provider AND model in one
# move, outranking ORCHESTRATOR_PROVIDER / *_ORCHESTRATOR_MODEL. Invalid
# values warn once and are ignored.
# ORCHESTRATOR_MODEL=zai-glm-4.7

# Other TTS providers (Abraham uses ElevenLabs; set only if switching):
# CARTESIA_API_KEY=
# Fish Audio: the cheap tier (15 cr/1k vs 50). Billed per UTF-8 byte.
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_MODEL_ID=s2.1-pro
# CARTESIA_VERSION=
# CARTESIA_MODEL_ID=
# POCKET_TTS_BASE_URL=          # dedicated Pocket TTS host
# POCKET_TTS_API_TOKEN=         # shared bearer token for billable endpoints
# KYUTAI_TTS_BASE_URL=          # legacy shared audio-rt host during migration
# KYUTAI_BASE_URL=

# ElevenLabs overrides (voice is resolved from the DB — leave unless overriding):
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=
# ELEVENLABS_FALLBACK_VOICE_SLUG=
# ELEVENLABS_FALLBACK_VOICE_ID=
# ELEVENLABS_ENFORCE_NORMAL_PRICING=
# ELEVENLABS_ALLOW_PROFESSIONAL_VOICES=

# The dramaturg — async scene reflection writing a director's note the fast
# per-turn director reads (off the voice hot path; failures never touch turns).
# VOICE_AGENT_DRAMATURG=1              # =0 disables entirely
# VOICE_AGENT_DRAMATURG_MODEL=gpt-oss-120b # fast structured model; needs the
#                                      # matching provider key. Unknown ids warn
#                                      # and fall back to the default. Also the
#                                      # generated-opening model.
# VOICE_AGENT_DRAMATURG_EVERY=2        # reflect every N spoken turns
# VOICE_AGENT_DRAMATURG_TIMEOUT_MS=10000
# VOICE_AGENT_DRAMATURG_MAX_TOKENS=2400 # reasoning + complete structured reflection
# LIVEKIT_AGENT_NAME=kawabunga-live-scene-v1 # explicit dispatch; must match token minting
# VOICE_AGENT_FIRST_MOVE_MS=1500       # delay before the scene's first move
# VOICE_AGENT_REACTION_MODEL=claude-haiku-4-5 # stronger brain for narration-hidden reactions/opening move only
#                                      # (a character receiving the visitor
#                                      # after the opening narration)
# VOICE_AGENT_CASCADE_MAX=4            # max driver-initiated beats per user
#                                      # turn when the director declares
#                                      # momentum (crisis cascades)

# Cost ledger pricing overrides. Public Cerebras/ElevenLabs/LiveKit Inference
# rates are snapshotted in code; set project-specific rates for self-hosted TTS
# and LiveKit room/media allocation so those entries become priced instead of
# explicitly "unpriced" in the session workbench.
# LIVEKIT_INFERENCE_PLAN=scale
# SESSION_COST_LIVEKIT_SESSION_USD_PER_MINUTE=
# SESSION_COST_STT_USD_PER_MINUTE=
# SESSION_COST_POCKET_TTS_USD_PER_MILLION_CHARACTERS=
# SESSION_COST_CARTESIA_USD_PER_MILLION_CHARACTERS=
# SESSION_COST_EMBEDDING_USD_PER_MILLION_TOKENS=0.02
# SESSION_COST_ELEVENLABS_FLASH_USD_PER_MILLION_CHARACTERS=50
# SESSION_COST_ELEVENLABS_PREMIUM_USD_PER_MILLION_CHARACTERS=100

# Scene audio (Phase 2): the world-audio track carrying the ambience bed.
# Default ON — scenes without an authored bed stay silent. Gains are dB.
# VOICE_AGENT_WORLD_AUDIO=1     # =0 kills the world-audio track entirely
# VOICE_AGENT_WORLD_GAIN_DB=-12 # master gain vs the ingest-normalized assets
# VOICE_AGENT_WORLD_DUCK_DB=-12 # extra attenuation while the agent speaks
# VOICE_AGENT_NOISE_CANCELLATION=1 # =0 only for synthetic headless E2E audio
# VOICE_AGENT_REPLY_MAX_TOKENS=2048 # technical runaway ceiling; director owns spoken length

# Pipeline flags / tuning (sensible defaults if unset):
# TTS_PROVIDER=                 STT_PROVIDER=
# TTS_FALLBACK_PROVIDER=        TTS_ENABLE_FALLBACK=
# TTS_FIRST_AUDIO_TIMEOUT_MS=   VOICE_STREAM_TTS_FALLBACK_PROVIDER=
# VOICE_SEMANTIC_RETRIEVAL=     VOICE_RETRIEVAL_BUDGET_MS=
# VOICE_ACK_LANE=               WIKI_GRAPH_CACHE=
# WS_NO_UTF_8_VALIDATE=         WS_NO_BUFFER_UTIL=

# Railway healthcheck port (the agents worker doesn't serve HTTP itself).
HEALTH_PORT=8080

# Leave EMBEDDING_PROVIDER UNSET → bge runs warm in-process (the whole point of
# this host). Setting it to "openai" forces the cold OpenAI embed path.
